{
  "api": {
    "services": [
      "HandlerService",
      "RoutingService"
    ],
    "tag": "api"
  },
  "dns": {
    "hosts": {},
    "queryStrategy": "UseIPv4",
    "serveExpiredTTL": 300,
    "serveStale": true,
    "servers": [
      {
        "address": "https+local://1.1.1.1/dns-query",
        "domains": [
          "full:dns.example.net",
          "full:vpn.example.com"
        ],
        "skipFallback": true
      },
      {
        "address": "https+local://8.8.8.8/dns-query",
        "domains": [
          "full:dns.example.net",
          "full:vpn.example.com"
        ],
        "skipFallback": true
      },
      {
        "address": "https://dns.example.net/dns-query",
        "timeoutMs": 2000
      },
      "https+local://1.1.1.1/dns-query",
      "https+local://8.8.8.8/dns-query"
    ],
    "tag": "dns-internal"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 31001,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": false
      },
      "tag": "socks-in"
    },
    {
      "listen": "C:/Users/test/network/ipc/api-main.sock",
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1",
        "port": 1
      },
      "tag": "api"
    },
    {
      "listen": "127.0.0.1",
      "port": 31003,
      "protocol": "http",
      "settings": {},
      "tag": "probe-proxy"
    },
    {
      "listen": "127.0.0.1",
      "port": 31004,
      "protocol": "http",
      "settings": {},
      "tag": "probe-direct"
    }
  ],
  "log": {
    "access": "none",
    "dnsLog": false,
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "vpn.example.com",
            "port": 443,
            "users": [
              {
                "encryption": "none",
                "id": "00000000-0000-0000-0000-000000000000"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "httpupgradeSettings": {
          "host": "h.example.org",
          "path": "/u"
        },
        "network": "httpupgrade",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "UseIPv4"
        },
        "tlsSettings": {
          "fingerprint": "chrome",
          "serverName": "vpn.example.com"
        }
      },
      "tag": "proxy"
    },
    {
      "protocol": "freedom",
      "settings": {},
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4"
        }
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "settings": {},
      "tag": "block"
    }
  ],
  "routing": {
    "balancers": [
      {
        "selector": [
          "proxy"
        ],
        "tag": "active"
      },
      {
        "selector": [
          "proxy"
        ],
        "tag": "probe"
      }
    ],
    "domainStrategy": "AsIs",
    "rules": [
      {
        "inboundTag": [
          "api"
        ],
        "outboundTag": "api",
        "type": "field"
      },
      {
        "balancerTag": "probe",
        "inboundTag": [
          "probe-proxy"
        ],
        "type": "field"
      },
      {
        "inboundTag": [
          "probe-direct"
        ],
        "outboundTag": "direct",
        "type": "field"
      },
      {
        "ip": [
          "0.0.0.0/8",
          "10.0.0.0/8",
          "100.64.0.0/10",
          "127.0.0.0/8",
          "169.254.0.0/16",
          "172.16.0.0/12",
          "192.0.0.0/24",
          "192.168.0.0/16",
          "198.18.0.0/15",
          "::1/128",
          "fc00::/7",
          "fe80::/10"
        ],
        "outboundTag": "block",
        "type": "field"
      },
      {
        "balancerTag": "active",
        "inboundTag": [
          "dns-internal"
        ],
        "type": "field"
      },
      {
        "balancerTag": "active",
        "inboundTag": [
          "socks-in"
        ],
        "type": "field"
      }
    ]
  }
}
