{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Береста",
        "visible": true,
        "width": 1652,
        "height": 1160,
        "minWidth": 800,
        "minHeight": 560,
        "maximized": false,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss: blob: http: https:",
        "script-src": "'self' 'wasm-unsafe-eval' https://t.me/_websync_ https://telegram.me/_websync_ https://telegram.dog/_websync_",
        "worker-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https://ss3.4sqi.net/img/categories_v2/",
        "media-src": "'self' blob: data:",
        "object-src": "'none'",
        "frame-src": "http: https: bitkeep: bnc: bybitapp: echooo: imtokenv2: mytonwallet-tc: nicegram-tc: safepal-tc: tonkeeper-pro-tc: tonkeeper-tc:",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:desktop",
    "removeUnusedCommands": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tg"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "category": "SocialNetworking",
    "copyright": "Egoist",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Береста: local-first desktop hub for messengers and social networks using the Windows network configuration",
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
