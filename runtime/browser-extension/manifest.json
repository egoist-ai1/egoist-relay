{
  "manifest_version": 3,
  "name": "Открыть в Бересте",
  "version": "0.1.0",
  "description": "Открывает текущую страницу Telegram в Бересте по нажатию кнопки.",
  "icons": {
    "16": "icons/beresta-16.png",
    "32": "icons/beresta-32.png",
    "48": "icons/beresta-48.png",
    "128": "icons/beresta-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.t.me/*",
        "https://telegram.me/*",
        "https://telegram.dog/*",
        "https://web.telegram.org/a",
        "https://web.telegram.org/a?*",
        "https://web.telegram.org/a/*",
        "https://web.telegram.org/k",
        "https://web.telegram.org/k?*",
        "https://web.telegram.org/k/*",
        "https://web.telegram.org/z",
        "https://web.telegram.org/z?*",
        "https://web.telegram.org/z/*"
      ],
      "js": ["content.js"]
    }
  ]
}
