+async def _select_cf_proxy(dc: int):
+    slots = asyncio.Semaphore(CF_SELECTION_CONCURRENCY)
+
+    async def probe(base_domain):
+        async with slots:
+            domain = f'kws{dc}.{base_domain}'
+            try:
+                ws = await asyncio.wait_for(RawWebSocket.connect(
