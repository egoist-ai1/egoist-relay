+                    secure=not proxy_config.disable_secure,
+                ), CF_PREFLIGHT_TIMEOUT)
+                return base_domain, ws
+            except Exception:
+                return None
+
+    tasks = [asyncio.create_task(probe(domain)) for domain in balancer.get_domains_for_dc(dc)]
+    selected = None
+    completed = False
+
+    async def cleanup():
+        for task in tasks:
+            if not task.done():
+                task.cancel()
+        results = await asyncio.gather(*tasks, return_exceptions=True)
+        await asyncio.gather(*(
+            result[1].close() for result in results
+            if isinstance(result, tuple) and (not completed or result is not selected)
+        ), return_exceptions=True)
+
+    try:
+        for candidate in asyncio.as_completed(tasks):
+            result = await candidate
+            if result is not None:
+                selected = result
+                break
+        completed = True
+        return selected
+    finally:
+        cleanup_task = asyncio.create_task(cleanup())
+        try:
+            await asyncio.shield(cleanup_task)
+        except BaseException:
+            await cleanup_task
+            if selected is not None:
+                await selected[1].close()
+            raise
+
