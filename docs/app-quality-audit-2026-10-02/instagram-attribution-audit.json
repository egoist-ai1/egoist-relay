    "initialHarnessCorrection": "First receipt retained separately; synthetic transport originally retained JS undefined keys. It was corrected to JSON roundtrip before the v2 diagnostic count; those extra failures were fixture errors, not production defects. v3 also aligns fixture target envelopes with the inspected native canonical routing. Both real contract failures persist.",
    "envelopeFidelity": "v3 requests use native canonical /reel/ID targets; profile target guard uses channel_history, as in the real operation contract."
  },
  "proposals": [
    {
      "id": "explicit-page-provenance",
      "apply": false,
      "change": "Keep observed profile metadata under pageMetadata with sourceUrl; add sourceContext with selected profile/document locator and collection kind. Expose publisher_unobserved/collaboration_unverified when there is no explicit detail evidence. Verify page locator against native document binding before accepting it.",
      "preserve": [
        "Original observed post URL",
        "First-party origin/source guards",
        "Account identity/epoch binding",
        "No author inferred from URL prefix"
      ]
    },
    {
      "id": "bounded-detail-attribution",
      "apply": false,
      "change": "A future explicitly selected exact-post read may supply observed header/caption/time and collaboration evidence. Missing evidence must stay missing; no private API or automatic broad follow-up crawl.",
      "preserve": [
        "Selected public sources only",
        "No claims of universal/full platform access",
        "No account mutation"
      ]
    },
    {
      "id": "consistent-same-post-caption",
      "apply": false,
      "change": "Use one strict first-party same-post locator comparison for caption fallback, aligned with native validated kind/shortcode aliases. Only accept metadata for that same exact post; reject different IDs/origins or malformed routes.",
      "preserve": [
        "Native origin, source and author-evidence guards",
        "Existing wrong-profile/wrong-shortcode rejection",
        "No profile biography promoted to post caption"
      ]
    }
  ],
  "remainingGates": [
    "Real publisher or collaboration relationship for the two observed public reels is not established by current saved evidence.",
    "Potential recommendation-vs-profile-grid membership cannot be decided: collect accepts broad main articles/anchors and records do not identify grid membership. No claim is made that real recommendations caused this result.",
    "Native rules are inspected and their existing tests located, but native WebView binding was not executed by this browser fixture audit.",
    "Parent owns frozen release/manual installation decisions and any later fix; this investigation did not reopen or edit production sources."
  ],
