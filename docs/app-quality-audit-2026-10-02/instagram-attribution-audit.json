  "actualFindings": [
    {
      "id": "profile-context-vs-publisher",
      "classification": "unverifiable_publisher_relationship",
      "observed": "Selected channel openai produced two observed first-party /chatgpt/reel locators. Author, caption and timestamp are absent; no collaborator field exists.",
      "conclusion": "The data prove accepted links collected under the selected profile-page job, not ownership, collaboration or a redirect. A different handle in URL alone cannot establish a real publisher.",
      "fabricatedPublisherFound": false,
      "collaborationVerified": false
    },
    {
      "id": "page-metadata-provenance",
      "classification": "reproduced_provenance_defect",
      "profileDescriptionHash": "9cb15207388fb3886d6f532a5220fe1267a139fe97f0a4c89d8dea86e7db74aa",
      "profileDescriptionRepeatedAcrossReels": true,
      "observed": "Each reel.description equals the selected profile discovery description; fieldEvidence has no description page provenance, and captions are explicitly unobserved.",
      "conclusion": "Observed page metadata was copied, not invented, but attaching it to reel.description without explicit profile-page provenance is ambiguous. Current human formatter labels it page description; raw record consumers still need a clear context field."
    },
    {
      "id": "same-shortcode-caption-alias",
      "classification": "reproduced_content_omission",
      "observed": "Both actual helpers accept /reel/ID page for /chatgpt/reel/ID request, but drop the OG-caption text fallback when the observed anchor preserves the handle.",
      "conclusion": "Canonical path comparison differs between target acceptance/native normalization and caption fallback. This loses an observed page-specific caption on an otherwise accepted same-post alias."
    }
  ],
